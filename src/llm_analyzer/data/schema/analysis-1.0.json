              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Safe Ram Bytes"
        },
        "safe_vram_bytes": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Safe Vram Bytes"
        },
        "estimated_host_bytes": {
          "maximum": 9223372036854775807,
          "minimum": 0,
