        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/PlatformInfo"
        },
        "cpu": {
          "$ref": "#/$defs/CPUInfo"
        },
        "memory": {
          "$ref": "#/$defs/MemoryInfo"
