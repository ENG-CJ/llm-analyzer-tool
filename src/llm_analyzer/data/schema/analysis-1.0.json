        "context": {
          "default": 4096,
          "maximum": 1048576,
          "minimum": 128,
          "title": "Context",
          "type": "integer"
        },
        "top": {
          "default": 5,
          "maximum": 100,
          "minimum": 1,
          "title": "Top",
          "type": "integer"
        },
        "runtime": {
          "default": "auto",
          "title": "Runtime",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "quant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quant"
        }
      },
      "title": "AnalysisRequest",
      "type": "object"
    },
    "BackendInfo": {
