      "type": "object"
    },
    "HardwareScanResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "application_version": {
          "default": "0.1.0",
          "title": "Application Version",
          "type": "string"
