          "type": "string"
        },
        "confidence": {
          "default": "unknown",
          "title": "Confidence",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "title": "BackendInfo",
      "type": "object"
    },
    "CPUInfo": {
      "additionalProperties": false,
