            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Physical Cores"
        },
        "logical_cores": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
