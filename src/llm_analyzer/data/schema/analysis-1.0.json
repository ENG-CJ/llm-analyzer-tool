        "display_name",
        "parameters",
        "quantization",
        "bits_estimate",
        "context",
        "runtime",
        "runtime_installed",
        "fit",
        "execution",
        "memory",
        "safe_ram_bytes",
        "estimated_host_bytes",
        "confidence",
        "reasons"
