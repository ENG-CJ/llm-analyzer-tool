{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "application_version": {
      "default": "0.1.0",
      "title": "Application Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "mode": {
      "const": "system",
      "default": "system",
      "title": "Mode",
      "type": "string"
    },
    "operation": {
      "default": "SHA-256, fixed 1 MiB buffer, single worker",
      "title": "Operation",
      "type": "string"
    },
    "elapsed_seconds": {
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "processed_bytes": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Processed Bytes",
      "type": "integer"
    },
    "throughput_mib_per_second": {
      "title": "Throughput Mib Per Second",
      "type": "number"
    },
    "ram_peak_bytes": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ram Peak Bytes"
    },
    "inference_tokens_per_second": {
      "default": null,
      "title": "Inference Tokens Per Second",
      "type": "null"
    },
    "note": {
      "default": "Measured CPU hashing throughput; cannot predict LLM inference speed",
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "elapsed_seconds",
    "processed_bytes",
    "throughput_mib_per_second"
  ],
  "title": "BenchmarkResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
